+bool gfxFontconfigFontEntry::MayHaveColorGlyphFor(uint32_t aCh,
+                                                uint32_t aNextCh) {
+  if (IsUserFont()) {
+    return true;
+  }
+
+  // Enumerate raw directory tags: an unreadable or malformed color table must
+  // not be mistaken for a font that cannot provide color.
+  auto face = GetHBFace();
+  unsigned int total = hb_face_get_table_tags(face, 0, nullptr, nullptr);
+  if (!total) {
+    return true;
+  }
+  unsigned int cmapCount = 0;
+  for (unsigned int offset = 0; offset < total;) {
+    hb_tag_t tags[16];
+    unsigned int count = std::min(16u, total - offset);
+    unsigned int expected = count;
+    if (hb_face_get_table_tags(face, offset, &count, tags) != total ||
+        count != expected) {
+      return true;
+    }
+    for (unsigned int i = 0; i < count; ++i) {
+      switch (tags[i]) {
+        case TRUETYPE_TAG('C', 'B', 'D', 'T'):
+        case TRUETYPE_TAG('s', 'b', 'i', 'x'):
+        case TRUETYPE_TAG('C', 'O', 'L', 'R'):
+        case TRUETYPE_TAG('S', 'V', 'G', ' '):
+          return true;
+        case TRUETYPE_TAG('c', 'm', 'a', 'p'):
+          ++cmapCount;
+          break;
+      }
+    }
+    offset += count;
+  }
+  if (aNextCh != unicode::kVariationSelector16) {
+    return false;
+  }
+  if (cmapCount != 1 || gfxFontUtils::GetUVSFallback(aCh, aNextCh)) {
+    return true;
+  }
+
+  // Both default and non-default UVS mappings can imply emoji presentation.
+  // Shared charmaps do not carry mUVSOffset, so inspect every raw subtable.
+  AutoTable cmap(this, TRUETYPE_TAG('c', 'm', 'a', 'p'));
+  if (!cmap) {
+    return true;
+  }
+  unsigned int length;
+  const auto* data =
+      reinterpret_cast<const uint8_t*>(hb_blob_get_data(cmap, &length));
+  if (length < 4 || gfxFontUtils::ReadShortAt(data, 0) != 0) {
+    return true;
+  }
+  uint16_t count = gfxFontUtils::ReadShortAt(data, 2);
+  if (!count || count > (length - 4) / 8) {
+    return true;
+  }
+  for (uint16_t i = 0; i < count; ++i) {
+    uint32_t offset = gfxFontUtils::ReadLongAt(data, 4 + uint32_t(i) * 8 + 4);
+    if (offset > length - 2 || gfxFontUtils::ReadShortAt(data, offset) == 14) {
+      return true;
+    }
+  }
+  return false;
+}
